# Backend API manzili (brauzer va Next.js server uchun)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Admin panel: cookie imzosi va backend proxy kaliti uchun sir (64 belgi; backend bilan bir xil)
ADMIN_SESSION_SECRET=
# (ixtiyoriy) admin proxy uchun alohida backend manzili; bo'lmasa NEXT_PUBLIC_API_URL
ADMIN_API_URL=

# Sotuvchi rekvizitlari (/oferta, /aloqa, footer). Bo'sh yoki noto'g'ri qiymat saytda ko'rinmaydi.
# 9 xonali STIR; JSHSHIR (14 xonali) bu yerga yozilmaydi
NEXT_PUBLIC_SELLER_STIR=
# Bank MFO (5 xonali)
NEXT_PUBLIC_SELLER_MFO=
# Hisob raqam (20 xonali)
NEXT_PUBLIC_SELLER_ACCOUNT=
# Onlayn to'lov ulanganda true: "Sotib olish" tugmasi va to'lov tizimlari logolari
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Haqiqiy o'quvchi fikrlari qo'shilganda true
NEXT_PUBLIC_SHOW_TESTIMONIALS=false
