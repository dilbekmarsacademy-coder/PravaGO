{
  "name": "pravatayyor-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "vercel-build": "prisma migrate deploy && nest build && npm run seed",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node prisma/seed.ts",
    "import:day": "ts-node scripts/import-day.ts",
    "import:day1": "ts-node scripts/import-day.ts --day 1",
    "import:day2": "ts-node scripts/import-day.ts --day 2",
    "import:day3": "ts-node scripts/import-day.ts --day 3",
    "import:day4": "ts-node scripts/import-day.ts --day 4",
    "import:day5": "ts-node scripts/import-day.ts --day 5",
    "import:day6": "ts-node scripts/import-day.ts --day 6",
    "content:clear": "ts-node prisma/clear-content.ts",
    "admin:create": "ts-node scripts/admin-create.ts",
    "admin:reset-password": "ts-node scripts/admin-reset-password.ts",
    "admin:hash-code": "ts-node scripts/admin-hash-code.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.ts\"",
    "test:e2e": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.5.0",
    "@techstark/opencv-js": "^4.10.0-release.1",
    "@vercel/functions": "^3.10.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "@xmldom/xmldom": "^0.8.15",
    "jszip": "^3.10.1",
    "node-html-parser": "^7.1.0",
    "prisma": "^6.5.0",
    "sharp": "^0.34.5",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@imgly/background-removal-node": {
      "sharp": "$sharp"
    }
  }
}
