generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id             String             @id @default(uuid())
  slug           String             @unique
  title          String // o'zbek lotin
  titleCyrl      String?
  titleRu        String?
  /// Kurs kuni (1–6) va kun ichidagi tartib — frontend'dagi src/data/curriculum.ts bilan bir xil.
  day            Int?
  dayOrder       Int?
  /// "course" — kurs mavzusi (dayN-topicM); "collection" — admin qo'shgan "Yangi testlar" to'plami.
  kind           String             @default("course") @db.VarChar(20)
  /// Faqat "collection" uchun: nashr qilinganmi (qoralama foydalanuvchiga ko'rinmaydi).
  published      Boolean            @default(true)
  /// "Yangi testlar" ro'yxatidagi tartib.
  sortOrder      Int                @default(0)
  deletedAt      DateTime?          @db.Timestamptz(3)
  questions      Question[]
  savedQuestions SavedQuestion[]
  testAttempts   TopicTestAttempt[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Question {
  id              String           @id @default(uuid())
  topicId         String
  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text            String // o'zbek kirill
  /// O'zbek lotin (bo'lmasa frontend kirilldan transliteratsiya qiladi).
  textLatn        String?
  textRu          String? // ruscha tarjima
  /// Rasm yo'li (`/images/...` — backend manziliga nisbatan, klient to'liq URL qiladi) yoki to'liq URL.
  /// Rasmsiz savolda null.
  imageUrl        String?
  /// Rasmning asl o'lchamlari — frontend joyni oldindan ajratadi (layout shift bo'lmaydi).
  imageWidth      Int?
  imageHeight     Int?
  /// Admin yuklagan (tozalangan, tasdiqlangan) rasm — imageUrl `/media/<id>.webp`.
  imageAssetId    String?
  order           Int
  /// Yumshoq o'chirish — o'chirilgan savol hech qayerda chiqmaydi.
  deletedAt       DateTime?        @db.Timestamptz(3)
  /// Izoh (manbada bo'lsa): kirill / lotin / rus.
  explanation     String?
  explanationLatn String?
  explanationRu   String?
  /// Eski format: javob kalit so'zi bitta matn sifatida. Yangi kalit so'zlar — QuestionKeyword.
  keyword         String
  keywordRu       String?
  needsReview     Boolean          @default(false)
  /// Ruscha tarjima qo'lda tekshirilmagan (mashina/AI tarjimasi).
  ruNeedsReview   Boolean          @default(false)
  options         Option[]
  keywords        QuestionKeyword?
  savedBy         SavedQuestion[]
  keywordReviews  KeywordReview[]
  answerLogs      AnswerLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([topicId, order])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Manbadagi tartib (F1, F2, ...) — 1 dan.
  order      Int      @default(0)
  text       String // o'zbek kirill
  textLatn   String?
  textRu     String?
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([questionId, order])
}

/// Savol va javob kalit so'zlari. Faqat javob berilgandan keyin (yoki
/// "Kalit so'zlar" bo'limida) chiqariladi. Matn bo'lmasa — "kalit so'z mavjud emas".
///
/// `highlights` — matndagi belgilash oralig'i `[start, end)`:
///   { question: { uz?, cyrl?, ru? }, answer: { uz?, cyrl?, ru? } }
/// `question.*` — savol matniga (Question.textLatn / text / textRu) nisbatan,
/// `answer.*` — to'g'ri variant matniga (Option.textLatn / text / textRu) nisbatan.
model QuestionKeyword {
  questionId       String   @id
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Savol kaliti (lotin / kirill / rus).
  questionText     String?
  questionTextCyrl String?
  questionTextRu   String?
  /// Javob kaliti (lotin / kirill / rus).
  answerText       String?
  answerTextCyrl   String?
  answerTextRu     String?
  highlights       Json     @default("{}")
  /// "html" | "docx" | "none"
  source           String
  /// Manba docx'dagi "Kalit so'z: ..." qatori (agar bo'lsa) — HTML kaliti asosiy.
  docxKeyword      String?
  /// Kirill/rus kalit so'zi yoki belgilash avtomatik topilmagan — qo'lda tekshirish kerak.
  needsReview      Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

/// "Kalit so'zlar" bo'limidagi "ko'rib chiqdim" belgisi.
model KeywordReview {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, questionId])
  @@index([questionId])
}

/// Foydalanuvchi. Avval anonim (qurilma sessiyasi orqali yaratiladi);
/// ro'yxatdan o'tganda (POST /me/register) profil maydonlari to'ldiriladi.
/// Bitta foydalanuvchi — bir nechta qurilma sessiyasi (Session).
/// Ustun nomlari telefon OTP (Eskiz) branch'i bilan bir xil.
model User {
  id                String             @id @default(uuid())
  /// +998XXXXXXXXX (normallashtirilgan). Faqat admin API'da qaytariladi.
  phone             String?            @unique
  firstName         String?
  lastName          String?
  age               Int?
  /// "first-time" | "failed-before" | "license-revoked"
  examStatus        String?
  /// Telefon SMS-kod bilan tasdiqlangan vaqt (OTP branch'i to'ldiradi).
  phoneVerifiedAt   DateTime?          @db.Timestamptz(3)
  /// "uz-latn" | "uz-cyrl" | "ru"
  preferredLanguage String?            @db.VarChar(10)
  registeredAt      DateTime?          @db.Timestamptz(3)
  lastActiveAt      DateTime?          @db.Timestamptz(3)
  /// To'lovlar jadvalidan hisoblanadi (PaymentsService.syncUserPaymentStatus).
  paymentStatus     UserPaymentStatus  @default(NONE)
  accessGrantedAt   DateTime?          @db.Timestamptz(3)
  sessions          Session[]
  examAttempts      ExamAttempt[]
  savedQuestions    SavedQuestion[]
  lessonProgress    LessonProgress[]
  keywordReviews    KeywordReview[]
  testAttempts      TopicTestAttempt[]
  payments          Payment[]
  answerLogs        AnswerLog[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)

  @@index([registeredAt])
  @@index([lastActiveAt])
}

enum UserPaymentStatus {
  NONE
  PENDING
  PAID
}

/// Bearer token sessiyasi. Tokenning o'zi hech qayerda saqlanmaydi — faqat sha256 xeshi.
model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// Qurilma (admin panelda "Qurilmalar") — User-Agent qisqartirilgan holda.
  userAgent  String?   @db.VarChar(300)
  lastSeenAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)

  @@index([userId])
}

/// Imtihon urinishi. Yakunlanmagan urinishda saqlangan savolning javobi yopiq turadi.
model ExamAttempt {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?       @db.Timestamptz(3)
  savedQuestions SavedQuestion[]

  @@index([userId])
}

enum SavedSourceMode {
  practice
  exam
}

/// Foydalanuvchi saqlagan savollar ("Saqlanganlar").
model SavedQuestion {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Savolning mavzusi — filtrlash uchun denormalizatsiya qilingan.
  topicId    String
  topic      Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceMode SavedSourceMode @default(practice)
  attemptId  String?
  attempt    ExamAttempt?    @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  note       String?         @db.VarChar(500)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([userId, questionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, topicId])
}

/// Video dars progressi. Barcha qiymatlar serverda hisoblanadi (qarang:
/// LessonsService.reportProgress) — klient faqat xom o'lchovlarni yuboradi.
/// `lessonId` — src/lessons/lessons.config.ts dagi kalit.
model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  /// Eng uzoq ko'rilgan nuqta (soniya) — oldinga faqat shu yergacha o'tish mumkin.
  maxPosition    Float     @default(0)
  /// PLAYING holatida haqiqatan ko'rilgan soniyalar (takroriy ko'rishlar ham kiradi).
  watchedSeconds Float     @default(0)
  /// Davom ettirish nuqtasi.
  lastPosition   Float     @default(0)
  completedAt    DateTime? @db.Timestamptz(3)
  /// Oxirgi qabul qilingan hisobot — keyingi hisobotda qancha soniya qo'shish mumkinligini cheklaydi.
  lastReportAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, lessonId])
}

/// Mavzu testi natijasi. Foiz serverda hisoblanadi (yuborilgan javoblar bazadagi
/// to'g'ri javoblar bilan solishtiriladi) — kabinetdagi 98% qoidasi shunga tayanadi.
model TopicTestAttempt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  correct   Int
  total     Int
  percent   Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, topicId])
}

// ───────────────────────── Admin panel ─────────────────────────

enum AdminRole {
  OWNER
  DEVELOPER
}

/// Admin panel foydalanuvchisi (sayt egasi va dasturchi). Parol — argon2id xeshi.
model Admin {
  id                String         @id @default(uuid())
  name              String
  login             String         @unique
  role              AdminRole
  passwordHash      String
  active            Boolean        @default(true)
  lastLoginAt       DateTime?      @db.Timestamptz(3)
  passwordChangedAt DateTime?      @db.Timestamptz(3)
  sessions          AdminSession[]
  auditLogs         AuditLog[]
  confirmedPayments Payment[]      @relation("PaymentConfirmedBy")
  createdPayments   Payment[]      @relation("PaymentCreatedBy")
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
}

/// Admin sessiyasi (12 soat). Token faqat cookie'da — bazada sha256 xeshi.
model AdminSession {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ip        String?
  userAgent String?   @db.VarChar(300)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([adminId])
}

/// Har bir kirish urinishi — rate limit (IP va login bo'yicha) va xavfsizlik logi.
model AdminLoginAttempt {
  id        String   @id @default(uuid())
  login     String   @db.VarChar(100)
  ip        String   @db.VarChar(100)
  success   Boolean
  /// "bad_code" | "bad_credentials" | "inactive" | "rate_limited" | "ok"
  reason    String   @db.VarChar(40)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ip, createdAt])
  @@index([login, createdAt])
}

/// Audit log: kim, qachon, nimani o'zgartirdi (eski va yangi qiymat).
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String?  @db.VarChar(100)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// To'lov. Payme/Click ulanmaguncha — foydalanuvchi so'rov yuboradi
/// ("kutilmoqda"), admin qo'lda tasdiqlaydi yoki bekor qiladi.
model Payment {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  status        PaymentStatus @default(PENDING)
  /// "manual" (hozircha yagona usul)
  method        String        @default("manual") @db.VarChar(20)
  /// Admin izohi
  note          String?       @db.VarChar(500)
  /// Foydalanuvchi so'rov bilan yuborgan izoh
  userNote      String?       @db.VarChar(500)
  createdById   String?
  createdBy     Admin?        @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById String?
  confirmedBy   Admin?        @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?     @db.Timestamptz(3)
  cancelledAt   DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([userId])
}

/// Har bir javob tekshiruvi (check-answer) — eng ko'p xato qilinadigan savollar statistikasi uchun.
model AnswerLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correct    Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([questionId, correct])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Admin yuklagan rasmlar baytlari bazada (serverless'da fayl tizimi doimiy emas).
/// `public=false` — asl/oraliq nusxa, faqat admin API orqali; `true` — /media/:id.webp.
model MediaAsset {
  id          String   @id @default(uuid())
  /// "original" | "processed"
  kind        String   @db.VarChar(20)
  mime        String   @db.VarChar(50)
  width       Int
  height      Int
  size        Int
  sha256      String   @db.VarChar(64)
  public      Boolean  @default(false)
  data        Bytes
  /// Qaysi asl rasmdan olingan (processed uchun).
  sourceId    String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([sha256])
}

/// Rasmga ishlov berish vazifasi (avtomatik tozalash, qo'lda tahrir, fon kesish).
/// Og'ir ishlov so'rovdan keyin fon rejimida bajariladi — admin holatini so'rab turadi.
model ImageJob {
  id            String   @id @default(uuid())
  /// "auto" | "manual" | "original" | "remove-bg"
  type          String   @db.VarChar(20)
  /// "queued" | "running" | "done" | "failed"
  status        String   @default("queued") @db.VarChar(20)
  inputAssetId  String
  outputAssetId String?
  params        Json     @default("{}")
  /// AI aniqlagan hududlar, bajarilgan qadamlar va h.k.
  result        Json     @default("{}")
  error         String?  @db.VarChar(1000)
  createdById   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

/// Sayt hodisalari (o'zimizning analitika, tashqi servissiz). Shaxsiy ma'lumot
/// saqlanmaydi: IP va User-Agent yo'q — faqat tasodifiy qurilma/sessiya
/// identifikatorlari va qurilma turi.
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  /// page_view | session_start | ping | test_start | test_finish | video_watched | keywords_view | register | payment_request
  type      String   @db.VarChar(40)
  /// Brauzerdagi tasodifiy ID (localStorage) — DAU/WAU/MAU uchun.
  visitorId String   @db.VarChar(40)
  /// Tab sessiyasi (sessionStorage) — sessiya davomiyligi uchun.
  sessionId String   @db.VarChar(40)
  /// Ichki foydalanuvchi ID'si (sessiya bo'lsa) — ism/telefon emas.
  userId    String?
  path      String?  @db.VarChar(200)
  topicSlug String?  @db.VarChar(120)
  value     Float?
  /// mobile | tablet | desktop
  device    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
}

/// AI tahlil hisobotlari (yig'ma statistika asosida).
model AiReport {
  id           String            @id @default(uuid())
  /// "weekly" | "manual"
  kind         String            @db.VarChar(20)
  periodDays   Int
  stats        Json
  content      String
  model        String            @db.VarChar(60)
  inputTokens  Int               @default(0)
  outputTokens Int               @default(0)
  createdById  String?
  messages     AiReportMessage[]
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
}

/// Hisobot bo'yicha admin savollari va AI javoblari.
model AiReportMessage {
  id        String   @id @default(uuid())
  reportId  String
  report    AiReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role      String   @db.VarChar(20)
  content   String
  adminId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([reportId, createdAt])
}
