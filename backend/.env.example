DATABASE_URL=
TEST_DATABASE_URL=
ALLOWED_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3001
PORT=3001

# Admin panel
# 64 belgili tasodifiy sir — frontend'dagi ADMIN_SESSION_SECRET bilan bir xil
ADMIN_SESSION_SECRET=
# Maxsus kodning argon2id xeshi (base64). Yaratish: npm run admin:hash-code
ADMIN_ACCESS_CODE_HASH=
# Kurs kontentiga kirish faqat tasdiqlangan to'lov bilan ("true" / "false")
PAYMENT_ENFORCED=true

# AI (Claude): rasm tozalash, ruscha tarjima, statistika tahlili. Bo'lmasa — "sozlanmagan".
ANTHROPIC_API_KEY=
# Haftalik AI hisobot cron'i uchun (Vercel Cron Authorization: Bearer ...)
CRON_SECRET=
# Oylik AI budjeti ($): 80% da ogohlantirish, 100% da yangi importlar va xulosalar to'xtaydi
AI_MONTHLY_BUDGET_USD=
# Modellar (bo'sh — standart): fayl tahlili/rasmlar — claude-sonnet-5-5, tasnif/xulosalar — claude-haiku-5-5
AI_MODEL_PARSE=
AI_MODEL_FAST=
# Funksiya bo'yicha alohida (bo'sh — yuqoridagilar): ruscha tarjima (Sonnet), watermark (Sonnet), AI hisobot va "Statistikadan so'rash" (Haiku), o'quvchi tahlili (Haiku)
AI_MODEL_TRANSLATE=
AI_MODEL_WATERMARK=
AI_MODEL_IMPORT_WATERMARK=
AI_MODEL_REPORT=
AI_MODEL_STUDENT=

# Storage: local (dev, lokal papka) | s3 (production, Cloudflare R2) | db (R2 sozlanmaguncha, fayl ≤ 4 MB).
# Bo'sh — Vercel'da db, lokalda local.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
# Cloudflare R2 (S3-mos): https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_REGION=

# Haftalik natijalar yangilanishi (dushanba 22:00, Asia/Tashkent).
# Tashqi cron (cron-job.org) uchun: GET /cron/weekly-reset, "Authorization: Bearer <RESET_CRON_SECRET>".
# Vercel Cron (vercel.json) avtomatik CRON_SECRET bilan chaqiradi — ikkalasi ham qabul qilinadi.
RESET_CRON_SECRET=
# true — deploy'dan keyin bir marta BARCHA foydalanuvchilar natijalarini arxivlab nollaydi ("initial-launch").
# Faqat production'da, bir marta; ishlagandan keyin false qilib qo'ying.
INITIAL_RESET_ON_DEPLOY=false
# Bir martalik: "tester" akkauntining (ism/familiya/login = tester, aynan bitta) barcha
# natijalari, video va kalit so'zlar progressini arxivlab nollaydi va yangi oqimni
# (video → kalit so'zlar → test) yoqadi. WeeklyReset'da "tester-reset" yozuvi bo'lsa
# qayta ishlamaydi. Ishlagandan keyin false qiling.
TESTER_RESET_ON_DEPLOY=false
# Telefon SMS tasdig'i (hozircha o'chiq).
SMS_VERIFICATION_ENABLED=false
